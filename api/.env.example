TRUE_MARKET_BASE_URL=https://api.truemarkets.co/v1/gateway/
TRUE_MARKEY_UAT_BASE_URL=https://api.uat.truemarkets.co/v1/
MONGODB_URI=mongodb://localhost:27017/usetenth
TM_ENV=prod
TM_KEY_FILE=./api-key-config/<your-key-file>.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DRY_RUN=true
MAX_ORDER_USD=2
APP_MODE=demo
TM_SETTLEMENT_ASSET=PYUSD
MAX_USER_SPEND_USD=2
GLOBAL_FLOOR_USD=10
# Local dev only, when there is no public HTTPS in front of the API yet.
# On a VPS behind a reverse proxy + certbot domain, leave both unset: no tunnel is opened.
NGROK_AUTHTOKEN=
NGROK_TUNNEL_URL=
# Only used if the API's own domain also proxies the web app (see README). Leave the default if the web app is deployed separately (e.g. Vercel).
WEB_UPSTREAM_URL=http://localhost:3100
# Where the bot's buttons open: the web app's public URL (the reverse-proxy domain, or the Vercel URL).
WEB_APP_URL=
ADMIN_API_KEY=
INVITE_CODES=
TEST_BUY_ENABLED=false
TEST_BUY_MAX_USD=2

# Docker Compose only. Use letters and digits in the password: it goes inside a connection URL.
MONGO_USER=usetenth
MONGO_PASSWORD=
# Path on the host to the True Markets key file, mounted read-only into the container.
TM_KEY_HOST_PATH=./api-key-config/<your-key-file>.json
# Host port the API is published on. Pick one that is free on the machine (check `docker ps`
# for ports already taken by other containers) — it does not need to match PORT inside the container.
API_PORT=3300
